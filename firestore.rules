rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile doc: {householdId, displayName, email}.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Maps a short invite code to a householdId. Doc ID is the code itself,
    // so lookups are a get() by ID, never a query — no list access needed.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberUids;
      allow update, delete: if false;
    }

    // Maps a lowercased email to a pending invite: {householdId, invitedBy}.
    // Doc ID is the email itself, so a user can only ever get() their OWN
    // invite (via their verified auth token email) - never someone else's.
    match /invites/{emailId} {
      allow get: if request.auth != null && request.auth.token.email.lower() == emailId;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberUids;
      allow delete: if request.auth != null && (
        request.auth.token.email.lower() == emailId
        || request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberUids
      );
      allow update: if false;
    }

    match /households/{householdId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberUids;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      function touchesMembership() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids', 'members']);
      }

      // Joining: a non-member may update a household doc ONLY to append their
      // own uid to memberUids, and change nothing else.
      function isJoining() {
        return request.auth != null
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']);
      }

      // Accepting an email invite: a non-member may add themself (and clear
      // their own pendingInvites entry) ONLY if a matching invites/{email}
      // doc exists for their verified email and points at this household.
      function isAcceptingInvite() {
        return request.auth != null
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'pendingInvites'])
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.householdId == householdId;
      }

      // Leaving (any member removes themself) or the owner removing someone
      // else: memberUids/members shrink by exactly one member, nothing else
      // changes. Dropping to zero members is allowed - the household just
      // becomes permanently inaccessible (nobody is a member of it anymore),
      // which is harmless and is exactly what "abandon this household"
      // (e.g. created by mistake) needs to do.
      function isLeavingOrOwnerRemoving() {
        return request.auth != null
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
          && (
            (isMember() && !(request.auth.uid in request.resource.data.memberUids))
            || isOwner()
          );
      }

      // Editing display names in the members map without changing who's a
      // member at all (memberUids untouched).
      function isRenamingMembers() {
        return isMember()
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      }

      allow get: if isMember();
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isJoining() || isAcceptingInvite() || isLeavingOrOwnerRemoving() || isRenamingMembers() || (isMember() && !touchesMembership());
      allow delete: if false;

      match /expenses/{entryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
      }

      match /savings/{entryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
      }
    }
  }
}
